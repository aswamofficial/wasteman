# Wasteman API — production environment for the Utho box.
#
# Copy to /var/www/wasteman/wastenotify-api/.env and fill in every CHANGE_ME.
# Nothing here is a working value: the blanks are blanks because inventing a
# plausible one is worse than an obvious gap.
#
# After ANY edit to this file, run `php artisan config:cache` again — the
# config is cached in production, so .env changes do not take effect until it
# is rebuilt.

APP_NAME=Wasteman
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wasteman.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database -----------------------------------------------------------
# Wasteman's own database and its own user. The user is granted rights on this
# schema only, so a compromise here cannot read Clean Washroom's data.
# Port 3306: the local 3307 is an XAMPP quirk, not something the server shares.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wasteman
DB_USERNAME=wasteman
DB_PASSWORD=CHANGE_ME_STRONG

# --- Front end ----------------------------------------------------------
# Same origin as the API, so there is no cross-origin request to configure.
FRONTEND_URL=https://wasteman.in
SANCTUM_STATEFUL_DOMAINS=wasteman.in,www.wasteman.in
SESSION_DOMAIN=.wasteman.in

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- AI classification ---------------------------------------------------
# Without this the app silently runs the offline stand-in: every report is
# classified by the deterministic stub and badged "unverified" in the queue.
# The app works; the classification is not real.
ANTHROPIC_API_KEY=

# --- Push notifications --------------------------------------------------
# From the Firebase service-account JSON. Leave blank and every push is a
# logged no-op — in-app notifications still work.
# FCM_PRIVATE_KEY must keep its literal \n sequences and stay in quotes.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Mail ----------------------------------------------------------------
# `log` writes mail to the Laravel log instead of sending it. Password resets
# will not reach anyone until this is a real transport.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
