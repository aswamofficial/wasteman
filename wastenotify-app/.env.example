# Wasteman frontend environment (copy to .env)
VITE_API_URL=http://localhost/wastenotify/wastenotify-api/public/api
VITE_STORAGE_URL=http://localhost/wastenotify/wastenotify-api/public/storage
VITE_APP_URL=http://localhost:5299
# Maps JavaScript API must be enabled on this key.
VITE_GOOGLE_MAPS_API_KEY=
VITE_PUSH_ENABLED=false
